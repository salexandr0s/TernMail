// Copy this file to Secrets.xcconfig and fill it in. Secrets.xcconfig is git-ignored.

// The part of your iOS-type OAuth client ID before ".apps.googleusercontent.com".
GOOGLE_CLIENT_ID_PREFIX =

// Optional: set both values to use an installed signing certificate.
// Keep the same identity for Debug and Release so Keychain approvals survive rebuilds.
// A team ID alone does not replace ad-hoc signing.
// TERN_CODE_SIGN_IDENTITY = Developer ID Application: Your Name (TEAMID)
// TERN_DEVELOPMENT_TEAM = TEAMID
