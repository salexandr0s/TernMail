// Shared build settings for all configurations.
// Local OAuth and signing values go in the git-ignored Secrets.xcconfig.

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// The OAuth client ID is <prefix>.apps.googleusercontent.com and its redirect
// scheme is the reversed ID. Only the prefix is set locally.
GOOGLE_CLIENT_ID_PREFIX =
GOOGLE_CLIENT_ID = $(GOOGLE_CLIENT_ID_PREFIX).apps.googleusercontent.com
GOOGLE_REDIRECT_SCHEME = com.googleusercontent.apps.$(GOOGLE_CLIENT_ID_PREFIX)

// Local builds fall back to ad-hoc signing when no certificate is configured.
// Both the app and hosted tests use these values in Debug and Release.
TERN_CODE_SIGN_IDENTITY = -
TERN_DEVELOPMENT_TEAM =

#include? "Secrets.xcconfig"
